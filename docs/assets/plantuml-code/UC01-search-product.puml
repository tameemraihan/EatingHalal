@startuml
!pragma layout smetana
title Search for a Product
|User|
start
:Enter product name;
|System|
:Search hosted PostgreSQL records;
if (Local match?) then (yes)
  :Retrieve local matches;
else (no)
  :Query enabled external source
with cache, throttle and timeout;
  :Persist usable external results
with provenance;
endif
if (Any match?) then (yes)
  :Display product name and
available brand/packaging;
else (no)
  :Report no match / source availability;
  :Offer packaging-photo panel;
  |User|
  :Refine search or open photo panel;
  note right
    Panel exists; OCR is not implemented.
  end note
endif
stop
@enduml
