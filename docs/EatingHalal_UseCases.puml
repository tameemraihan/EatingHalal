@startuml EatingHalal_UseCases

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor White
  BorderColor #2C7BB6
  ArrowColor #333333
  ActorBackgroundColor White
  ActorBorderColor #2C7BB6
}
skinparam package {
  BorderColor #555555
  FontStyle bold
}
skinparam rectangle {
  BorderColor #999999
}

actor "Consumer" as Consumer
actor "External APIs" as APIs

rectangle "EatingHalal System" {

  package "Product Discovery" {
    usecase "UC01\nSearch for a Product" as UC01
    usecase "UC09\nFilter Search Results\nby Dietary Preference" as UC09
    usecase "UC11\nView Recently\nSearched Products" as UC11
    usecase "UC03\nUpload Product\nPackaging Photo" as UC03
  }

  package "Halal Assessment" {
    usecase "UC02\nView Halal Status\nof a Product" as UC02
    usecase "UC04\nView Ingredient\nAnalysis" as UC04
    usecase "UC05\nView Alternative\nHalal Products" as UC05
    usecase "UC13\nView Halal\nCertification Details" as UC13
  }

  package "Shopping List" {
    usecase "UC06\nAdd Product to\nShopping List" as UC06
    usecase "UC07\nView Shopping List" as UC07
    usecase "UC08\nRemove Product from\nShopping List" as UC08
  }

  package "Community & Feedback" {
    usecase "UC10\nShare a Product\nHalal Status" as UC10
    usecase "UC12\nReport Incorrect\nProduct Information" as UC12
  }

}

' --- Consumer associations ---
Consumer -- UC01
Consumer -- UC02
Consumer -- UC03
Consumer -- UC04
Consumer -- UC05
Consumer -- UC06
Consumer -- UC07
Consumer -- UC08
Consumer -- UC09
Consumer -- UC10
Consumer -- UC11
Consumer -- UC12
Consumer -- UC13

' --- External API associations ---
APIs -- UC01 : <<include>>
APIs -- UC02 : <<include>>
APIs -- UC03 : <<include>>
APIs -- UC13 : <<include>>

' --- Include relationships ---
UC01 .> UC02 : <<include>>
UC02 .> UC04 : <<extend>>
UC02 .> UC05 : <<extend>>
UC02 .> UC13 : <<extend>>
UC03 .> UC02 : <<include>>
UC07 .> UC08 : <<extend>>
UC01 .> UC09 : <<extend>>

@enduml
