@startuml EatingHalal_UseCases

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor White
  BorderColor #2C7BB6
  ArrowColor #333333
  ActorBackgroundColor White
  ActorBorderColor #2C7BB6
}
skinparam package {
  BorderColor #555555
  FontStyle bold
}
skinparam rectangle {
  BorderColor #999999
}

actor "User" as User
actor "Admin" as Admin
actor "External Services" as Services

rectangle "EatingHalal System" {

  package "This Semester (UC01–UC05)" {
    package "Product Discovery" {
      usecase "UC01\nSearch for a Product" as UC01
      usecase "UC03\nUpload Product\nPackaging Photo" as UC03
    }

    package "Halal Assessment" {
      usecase "UC02\nView Halal Status\nof a Product" as UC02
      usecase "UC04\nManage Stored Halal\nAssessment Results" as UC04
    }

    package "Shopping" {
      usecase "UC05\nManage Shopping List" as UC05
    }
  }

  package "Later Phase (UC06–UC08)" {
    usecase "UC06\nManage Uploaded\nProduct Photos" as UC06
    usecase "UC07\nManage Community\nFeatures" as UC07
    usecase "UC08\nManage User Profile" as UC08
  }

}

' --- User associations ---
User -- UC01
User -- UC02
User -- UC03
User -- UC05
User -- UC07
User -- UC08

' --- Admin associations ---
Admin -- UC04
Admin -- UC06

' --- External-service associations ---
Services -- UC01 : product data
Services -- UC02 : assessment data
Services -- UC03 : OCR / LLM

' --- Use-case relationships ---
UC03 .> UC01 : <<extend>>\nNo matching product

@enduml
